# Hermes Agent Environment Configuration
# Migrated from OpenClaw on 2026-04-18
# =============================================================================
# HERMES HOME (must match the directory containing this .env and config.yaml)
HERMES_HOME=<path>
# HuggingFace Mirror (for faster-whisper model download)
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_OFFLINE=0
# LLM PROVIDER (OpenCode Zen - via custom/OpenAI-compatible)
# VISION (Xiaomi MiMo - for image recognition)
XIAOMI_API_KEY=<your-key>
XIAOMI_BASE_URL=https://opencode.ai/zen/go/v1
XIAOMI_MODEL=mimo-v2.5
# MESSAGING - QQ Bot via OneBot (NapCat)
ONEBOT_WS_URL=<napcat-config>
ONEBOT_HTTP_URL=<napcat-config>
ONEBOT_ACCESS_TOKEN={{ONEBOT_ACCESS_TOKEN}}
ONEBOT_AUTO_DISCOVER_TOKEN=true
# ONEBOT_ALLOWED_USERS=<admin-qq>  # disabled — allow all users
# TTS Configuration (GPT-SoVITS)
TTS_ENABLED=true
TTS_BASE_URL=http://127.0.0.1:5000/v1
TTS_MODEL=tts-1
TTS_VOICE=default
# Gateway Settings
GATEWAY_PORT=18789
GATEWAY_BIND=loopback
GATEWAY_AUTH_TOKEN=<your-key>
GATEWAY_ALLOW_ALL_USERS=true
# Working Directory for Messaging
DEEPSEEK_API_KEY=<your-key>
DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1
DEEPSEEK_MODEL=deepseek-v4-flash
# Knowledge Base (Obsidian Vault)
OBSIDIAN_VAULT_PATH=<path>
# ── OneBot QQ ──
# ── Gateway ──
# ── TTS (Qwen on localhost:5000) ──
VOICE_TOOLS_OPENAI_KEY=<your-key>
HERMES_GATEWAY_BUSY_ACK_ENABLED=false
FEISHU_HOME_CHANNEL=<feishu-home-channel-id>
FEISHU_HOME_CHANNEL_THREAD_ID=
HERMES_SUPPRESS_HOME_CHANNEL_PROMPT=true
HERMES_EPHEMERAL_SYSTEM_PROMPT=你必须只使用中文回复。全部对话只用中文。Never speak Japanese. 你是用中文聊天的中国女高中生素世。
# OneBot self / admin identifiers
# (used by adapter.py for @-mention detection and /command gating)
ONEBOT_SELF_ID={{ONEBOT_SELF_ID}}
ONEBOT_ADMIN_ID=<admin-qq>
# Soyo sticker collection paths (used by sticker_curator_tool.py + adapter)
SOYO_CHIBI_ROOT=<your-pictures-dir>
SOYO_COLLECTION_ROOT=<your-pictures-dir>/soyo_collected
SOYO_STICKER_INDEX=<your-hermes-home>/soyo_sticker_collection.json
# Feishu app credentials for lark-cli
FEISHU_APP_ID=<feishu-app-id>
FEISHU_APP_SECRET=<feishu-app-secret>
